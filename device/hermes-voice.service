[Unit]
Description=Hermes headless wake-word voice assistant
After=pipewire.service wireplumber.service

[Service]
Type=simple
Environment=OPENAI_API_KEY=sk-local
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/iva/.hermes/hermes-agent
ExecStart=/home/iva/.hermes/hermes-agent/venv/bin/python /home/iva/hermes_voice_wake.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
